  {para_id:'PORTMSTR::1000-INITIALIZE', program_id:'PORTMSTR', name:'1000-INITIALIZE', start_line:103, end_line:114, complexity_score:1, has_perform:false, has_goto:false, has_call:false, has_stop_run:false, is_entry_point:false, is_terminal:false, is_dead_code:false, pseudocode_preview:'-- Paragraph 1000-INITIALIZE: Initialisation and setup IF NOT PORT-SUCCESS THEN CALL 9000-error'},
  {para_id:'PORTMSTR::2000-CREATE-PORTFOLIO', program_id:'PORTMSTR', name:'2000-CREATE-PORTFOLIO', start_line:115, end_line:137, complexity_score:4, has_perform:false, has_goto:false, has_call:false, has_stop_run:false, is_entry_point:false, is_terminal:false, is_dead_code:false, pseudocode_preview:'-- Paragraph 2000-CREATE-PORTFOLIO: Core business logic SET portfolio-record = ls-portfolio CALL 2100-validate-portfolio IF WS-RETURN-CODE NOT = WS-SUCCESS THEN CALL 9000-error WRITE portfolio-record to output IF PORT-DUP-KEY THEN CALL 9000-error IF NOT PORT-SUCCESS THEN CALL 9000-error'},
  {para_id:'PORTMSTR::2100-HANDLE-VSAM-ERROR', program_id:'PORTMSTR', name:'2100-HANDLE-VSAM-ERROR', start_line:243, end_line:267, complexity_score:8, has_perform:false, has_goto:false, has_call:false, has_stop_run:false, is_entry_point:false, is_terminal:false, is_dead_code:true, pseudocode_preview:'-- Paragraph 2100-HANDLE-VSAM-ERROR: Error handling SET ls-program-id = portmstr SET ls-category = err-cat-vsam SET ls-error-code = ws-file-status EVALUATE (WS-FILE-STATUS) SET ls-severity = err-warning SET ls-error-text = err-vsam-22 SET ls-severity = err-warning SET ls-error-text = err-vsam-23 SET'},
  {para_id:'PORTMSTR::2100-LOG-PORTFOLIO-UPDATE', program_id:'PORTMSTR', name:'2100-LOG-PORTFOLIO-UPDATE', start_line:268, end_line:288, complexity_score:1, has_perform:false, has_goto:false, has_call:false, has_stop_run:false, is_entry_point:false, is_terminal:false, is_dead_code:false, pseudocode_preview:'-- Paragraph 2100-LOG-PORTFOLIO-UPDATE: Core business logic SET ls-system-id = portfolio SET ls-user-id = userid SET ls-program = portmstr SET ls-terminal = terminal-id SET ls-type = tran SET ls-status = succ SET ls-port-id = port-id SET ls-acct-no = port-account-no SET ls-before-image = ws-before-i'},
  {para_id:'PORTMSTR::2100-VALIDATE-PORTFOLIO', program_id:'PORTMSTR', name:'2100-VALIDATE-PORTFOLIO', start_line:138, end_line:162, complexity_score:3, has_perform:false, has_goto:false, has_call:false, has_stop_run:false, is_entry_point:false, is_terminal:false, is_dead_code:false, pseudocode_preview:'-- Paragraph 2100-VALIDATE-PORTFOLIO: Validation logic IF PORT-ID(1:4) NOT = \'PORT\' THEN SET ws-return-code = ws-error IF PORT-NAME = SPACES THEN SET ws-return-code = ws-error SET ws-valid-status = port-status IF NOT VALID-STATUS THEN SET ws-return-code = ws-error'},
  {para_id:'PORTMSTR::3000-READ-PORTFOLIO', program_id:'PORTMSTR', name:'3000-READ-PORTFOLIO', start_line:163, end_line:182, complexity_score:10, has_perform:false, has_goto:false, has_call:false, has_stop_run:false, is_entry_point:false, is_terminal:false, is_dead_code:false, pseudocode_preview:'-- Paragraph 3000-READ-PORTFOLIO: Read input records SET portfolio-record = ls-portfolio READ next record from portfolio-file EVALUATE (TRUE) SET ls-portfolio = portfolio-record CALL 9000-error CALL 9000-error'},
