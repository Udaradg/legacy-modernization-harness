  {para_id:'PORTMSTR::5000-DELETE-PORTFOLIO', program_id:'PORTMSTR', name:'5000-DELETE-PORTFOLIO', start_line:209, end_line:227, complexity_score:5, has_perform:false, has_goto:false, has_call:false, has_stop_run:false, is_entry_point:false, is_terminal:false, is_dead_code:false, pseudocode_preview:'-- Paragraph 5000-DELETE-PORTFOLIO: Core business logic SET portfolio-record = ls-portfolio IF PORT-NOT-FOUND THEN CALL 9000-error IF NOT PORT-SUCCESS THEN CALL 9000-error'},
  {para_id:'PORTMSTR::6000-TERMINATE', program_id:'PORTMSTR', name:'6000-TERMINATE', start_line:228, end_line:233, complexity_score:0, has_perform:false, has_goto:false, has_call:false, has_stop_run:false, is_entry_point:false, is_terminal:false, is_dead_code:false, pseudocode_preview:'-- Paragraph 6000-TERMINATE: Core business logic CLOSE portfolio-file SET ls-return-code = ws-return-code'},
