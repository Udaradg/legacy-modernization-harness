  {para_id:'PORTDEL::2100-PROCESS-DELETE', program_id:'PORTDEL', name:'2100-PROCESS-DELETE', start_line:139, end_line:155, complexity_score:10, has_perform:false, has_goto:false, has_call:false, has_stop_run:false, is_entry_point:false, is_terminal:false, is_dead_code:false, pseudocode_preview:'-- Paragraph 2100-PROCESS-DELETE: Main processing logic SET port-key = del-key READ next record from portfolio-file EVALUATE (TRUE) CALL 2200-delete-record INCREMENT ws-not-fnd-count BY 1 INCREMENT ws-error-count BY 1 READ next record from error'},
  {para_id:'PORTDEL::2200-DELETE-RECORD', program_id:'PORTDEL', name:'2200-DELETE-RECORD', start_line:156, end_line:167, complexity_score:7, has_perform:false, has_goto:false, has_call:false, has_stop_run:false, is_entry_point:false, is_terminal:false, is_dead_code:false, pseudocode_preview:'-- Paragraph 2200-DELETE-RECORD: Core business logic IF WS-SUCCESS-STATUS THEN INCREMENT ws-delete-count BY 1 CALL 2300-write-audit INCREMENT ws-error-count BY 1'},
  {para_id:'PORTDEL::2300-WRITE-AUDIT', program_id:'PORTDEL', name:'2300-WRITE-AUDIT', start_line:168, end_line:183, complexity_score:5, has_perform:false, has_goto:false, has_call:false, has_stop_run:false, is_entry_point:false, is_terminal:false, is_dead_code:false, pseudocode_preview:'-- Paragraph 2300-WRITE-AUDIT: Write output records SET aud-timestamp = ws-timestamp SET aud-action = delete SET aud-key = port-key SET aud-reason = del-reason-code SET aud-status = port-status WRITE audit-record to output IF NOT WS-AUD-SUCCESS THEN WRITE failed to output'},
